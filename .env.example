# Kalshi API credentials (required only for signed/portfolio endpoints;
# public market data works without these).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Set to "false" to hit production instead of the demo environment.
KALSHI_USE_DEMO=true

# Overrides only needed if Kalshi changes these hosts.
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_DEMO_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2

# Required by run_live_trading.py only (real-money orders). Must be exactly
# this phrase -- a deliberate act, not something a stray "true" flips by
# accident. Leave unset for paper trading / dashboard use.
# LIVE_TRADING_CONFIRMED=yes-i-understand-real-money-is-at-risk

# Optional: push notifications on real trade open/close, via ntfy.sh (free,
# no account). Generate a long random topic name so it can't be guessed --
# anyone who knows the topic name can read your notifications --
# e.g. `openssl rand -hex 16`. Subscribe to the same name in the free ntfy
# Android app to receive them. Leave unset to disable notifications.
# NTFY_TOPIC=
