[Unit]
Description=MLB schedule collector - hourly polling from the free MLB Stats API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradebot
Group=tradebot
WorkingDirectory=/home/tradebot/TRADE_BOT
ExecStart=/home/tradebot/TRADE_BOT/.venv/bin/python3 run_mlb_data_collector.py
Restart=always
RestartSec=30
KillMode=process
StandardOutput=append:/home/tradebot/TRADE_BOT/logs/mlb_data_collector_stdout.log
StandardError=append:/home/tradebot/TRADE_BOT/logs/mlb_data_collector_stdout.log

# Hardening -- same as api.service/dashboard.service/btc-price-collector.service.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/tradebot/TRADE_BOT
PrivateTmp=true

[Install]
WantedBy=multi-user.target
