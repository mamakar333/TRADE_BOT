{{DASHBOARD_HOSTNAME}} {
	# Everything below this line is unreachable without the password --
	# Caddy checks basic_auth before reverse_proxy ever runs.
	# This is a TEMPLATE -- see deploy/README.md step 7. Don't copy this
	# file to the server as-is; the {{...}} placeholders get filled in
	# with `sed` first, into a generated file that Caddy actually reads.
	basic_auth {
		{{BASIC_AUTH_USER}} {{BASIC_AUTH_HASH}}
	}

	log {
		output file /var/log/caddy/access.log
	}

	# The native Android app talks to the JSON API (api.service, :8502);
	# everything else (browsers) goes to the Streamlit dashboard (:8501).
	# Same password gates both -- basic_auth above applies to the whole
	# site, this only decides which backend handles the request.
	@api path /api/*
	reverse_proxy @api 127.0.0.1:8502

	reverse_proxy 127.0.0.1:8501
}
